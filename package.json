{
  "name": "helvety-browser-extension-chromium",
  "version": "0.35.0",
  "private": true,
  "type": "module",
  "description": "Helvety Chromium side panel extension — E2EE CRUD for tasks, notes, contacts, links, and link folders",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "preinstall": "node scripts/ensure-helvety.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test && node scripts/check-extension-auth-consistency.mjs && node scripts/check-extension-e2ee-consistency.mjs",
    "ci:release": "pnpm run ci:check && pnpm run build"
  },
  "dependencies": {
    "@helvety/brand": "file:.helvety/packages/brand",
    "@helvety/extension-chrome": "file:.helvety/packages/extension-chrome",
    "@helvety/shared": "file:.helvety/packages/shared",
    "@helvety/ui": "file:.helvety/packages/ui",
    "@simplewebauthn/browser": "^13.3.0",
    "@supabase/supabase-js": "2.110.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@helvety/config": "file:.helvety/packages/config",
    "@testing-library/react": "^16.3.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10.7.0",
    "jsdom": "29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "@supabase/supabase-js": "2.110.2",
      "esbuild": "0.28.1",
      "@helvety/shared": "file:.helvety/packages/shared",
      "@helvety/brand": "file:.helvety/packages/brand",
      "@helvety/ui": "file:.helvety/packages/ui",
      "@helvety/extension-chrome": "file:.helvety/packages/extension-chrome",
      "@helvety/config": "file:.helvety/packages/config"
    }
  }
}
