{
  "name": "helvety-browser-extension-chromium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Helvety Chromium extension — E2EE tasks, contacts, notes, and links",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
    "ci:release": "pnpm run ci:check && pnpm run build"
  },
  "dependencies": {
    "@helvety/brand": "file:../helvety/packages/brand",
    "@helvety/config": "file:../helvety/packages/config",
    "@helvety/shared": "file:../helvety/packages/shared",
    "@helvety/ui": "file:../helvety/packages/ui",
    "@simplewebauthn/browser": "^13.3.0",
    "@supabase/supabase-js": "^2.106.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@helvety/config": "file:../helvety/packages/config",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/chrome": "^0.0.328",
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.4.0",
    "next": "^16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vite": "^7.0.0",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "@helvety/shared": "file:../helvety/packages/shared",
      "@helvety/brand": "file:../helvety/packages/brand",
      "@helvety/ui": "file:../helvety/packages/ui",
      "@helvety/config": "file:../helvety/packages/config"
    }
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  }
}
