{
  "manifest_version": 3,
  "name": "Helvety",
  "description": "Helvety end-to-end encrypted tasks, contacts, notes, and links",
  "version": "0.2.0",
  "homepage_url": "https://helvety.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://helvety.com/*",
    "https://*.helvety.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Helvety"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
