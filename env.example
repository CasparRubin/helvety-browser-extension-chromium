# Helvety Chromium extension — optional build-time overrides
#
# Public client configuration (Supabase URL, publishable key, Helvety HTTPS origins)
# is hardcoded in src/lib/config.ts — the same class of values as NEXT_PUBLIC_* on
# web zones. Do not put server secrets here.

# Override auth API base when targeting a non-production auth host (local dev only).
# Example: http://localhost:3002/auth
# VITE_HELVETY_AUTH_ORIGIN=
