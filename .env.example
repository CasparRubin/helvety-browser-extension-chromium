# Helvety Chromium extension — Vite build-time variables only.
#
# The popup cannot read this file at runtime; Vite inlines VITE_* when you build.
# Helvety URLs (auth, gateway) are fixed in src/lib/env.ts — not overridable here.
#
# Copy the same Supabase values as NEXT_PUBLIC_SUPABASE_* from your Helvety app .env.local:
#
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
